# Local AI Assistant Configuration Settings
# Copy this file to '.env' and edit as needed.

# Ollama Server Connection Settings
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:3b
LLM_TIMEOUT=120.0
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=1

# Gemini API Settings (Optional cloud backup/alternative)
# If provided, models starting with 'gemini-' will be routed to the Gemini API.
GEMINI_API_KEY=

# SQLite Caching Settings
CACHE_DB_PATH=benchmarks/cache.db
CACHE_TTL_HOURS=24

# RAG Index Settings (separate DB from cache to avoid lock contention)
RAG_DB_PATH=benchmarks/rag.db

# Security / Access Control Settings
# Comma-separated list of allowed origins. Default restricts to localhost only.
# Do NOT use '*' in production — it allows any site to call your local API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Max allowed size for request payloads (default is 2097152 bytes = 2MB)
# MAX_UPLOAD_SIZE=2097152

